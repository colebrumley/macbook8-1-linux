#!/bin/bash
# MacBook8,1: after a forced power-off or a hung resume the CS4208 sometimes does not answer
# the HDA controller's codec probe at boot ("snd_hda_intel 0000:00:1b.0: no codecs found!").
# The card then has no PCMs and every desktop is on "Dummy Output" until the next reboot.
# Re-probing the controller (unbind + bind) finds the codec again (FINDINGS F-17).
set -u
DRV=/sys/bus/pci/drivers/snd_hda_intel
has_cs4208() { grep -qs "CS4208" /proc/asound/card*/codec#*; }
for i in $(seq 1 10); do has_cs4208 && exit 0; sleep 1; done   # codec probe is asynchronous
for try in 1 2 3; do
  for d in "$DRV"/0000:*; do
    [ -e "$d" ] || continue
    ls -d "$d"/hdaudioC*D* >/dev/null 2>&1 && continue          # this controller has a codec
    dev=$(basename "$d")
    logger -t mb81-audio-recover "no codec on $dev, re-probing (try $try)"
    echo "$dev" > "$DRV/unbind"; sleep 1; echo "$dev" > "$DRV/bind"
  done
  for i in $(seq 1 10); do
    if has_cs4208; then
      logger -t mb81-audio-recover "CS4208 found"
      # sessions that started without the card need their PipeWire restarted: the guard does it
      for uid in $(loginctl list-users --no-legend | awk '$1>=1000 {print $1}'); do
        systemctl --user -M "$uid@" restart --no-block mb81-speaker-guard.service 2>/dev/null || true
      done
      exit 0
    fi
    sleep 1
  done
done
logger -t mb81-audio-recover "CS4208 still missing after 3 re-probes (a full power-off may be needed)"
exit 1
